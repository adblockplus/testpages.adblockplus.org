{% set case = "URL token" %}
{% set id = get_id(case) %}
<section id="{{id}}-section" class="testcase-panel">
  {{ heading(case) }}

  <p>Test that a <code>url:</code> token in the needle matches the request URL: the file is requested from a URL containing <code>url-token</code>, and its response is rewritten.</p>
  <div id="test-{{id}}" class="testcase-area">
    <div class="testcase-examplecontent" aria-label="{{id}}-example">Example Content</div>
    <div class="testcase-waiting-content" aria-label="{{id}}-waiting">Waiting 500ms to trigger snippet...</div>
    <div class="testcase-expected-view">XHR response was replaced</div>
  </div>
  <h3>Steps</h3>
  <ul class="testcase-steps">
    <li>Add filter #1.</li>
    <li>Refresh page.</li>
    <li>The script should display a green element and not a red element to the test case above.</li>
  </ul>
  <h3>Filters</h3>
  <ul id="{{id}}-filters" class="testcase-filters">
    <li><pre>{{ site_url|domain }}#$#replace-xhr-response 'landlord' 'url-token-replaced' 'url:url-token'</pre></li>
  </ul>
</section>

<script>
  "use strict";

  // A promisified version of XMLHttpRequest
  function makeRequest(requestURL) {
    return new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open("GET", requestURL);
      xhr.onload = function() {
        if (xhr.status >= 200 && xhr.status < 300) {
          resolve(xhr.response);
        } else {
          reject(Object.assign(new Error(xhr.statusText), {status: xhr.status}));
        }
      };
      xhr.onerror = function() {
        reject(Object.assign(new Error(xhr.statusText), {status: xhr.status}));
      };
      xhr.send();
    });
  }

  function handleResponseBasic(text) {
    const element = document.createElement("div");
    const testElement = document.getElementById("test-basic-usage");

    if (text.includes("{{ search1 }}")) {
      element.setAttribute("data-expectedresult", "fail");
      element.setAttribute("aria-label", "{{id}}-fail");
      element.innerHTML = "Failed. XHR response was not replaced";
    } else {
      element.setAttribute("data-expectedresult", "pass");
      element.innerHTML = "XHR response was replaced";
    }

    testElement.appendChild(element);
  }

  function handleResponse(text, testId, check) {
    const testElement = document.getElementById(testId);
    const element = document.createElement("div");

    if (check(text)) {
      element.setAttribute("data-expectedresult", "pass");
      element.innerHTML = "XHR response was replaced";
    } else {
      element.setAttribute("data-expectedresult", "fail");
      element.setAttribute("aria-label", `${testId}-fail`);
      element.innerHTML = "Failed. XHR response was not replaced";
    }

    testElement.appendChild(element);
  }

  setTimeout(() => {
    const url = "/testfiles/fetch-and-xhr/foo.txt";
    // The JSONPath cases need a JSON response, so they request their own file.
    const jsonUrl = "/testfiles/fetch-and-xhr/jsonpath.json";

    const tests = [
      {id: "test-string-replacement", check: text => text.includes("{{ replacement2 }}")},
      {id: "test-string-replacement-with-needle", check: text => text.includes("{{ replacement3 }}")},
      {id: "test-regex-parameters", check: text => text.includes("{{ replacement4 }}")},
      {id: "test-multiple-string-replacement", check: text => text.includes("{{ replacement5 }}")}
    ];

    const jsonTests = [
      {
        id: "test-jsonpath",
        check: text => !text.includes("true") && text.includes("jsonpath-replaced")
      },
      {
        id: "test-jsonpath-append",
        check: text => text.includes("sports") && text.includes("news") &&
          text.includes("appended-tag")
      },
      {
        id: "test-jsonpath-remove",
        check: text => !text.includes("banner") && !text.includes("sidebar") &&
          text.includes("article")
      }
    ];

    makeRequest(url)
    .then(response => {
      handleResponseBasic(response);
      tests.forEach(({id, check}) => handleResponse(response, id, check));
    });
    makeRequest(jsonUrl)
    .then(text => jsonTests.forEach(({id, check}) => handleResponse(text, id, check)));
    makeRequest(`${url}?url-token`)
    .then(text => handleResponse(text, "test-url-token", t => t.includes("url-token-replaced")));
    removeWaitingContent();
  }, 500);
</script>
