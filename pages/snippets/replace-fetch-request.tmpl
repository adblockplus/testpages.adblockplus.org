{% set case = "JSONPath append" %}
{% set id = get_id(case) %}
<section id="{{id}}-section" class="testcase-panel">
  {{ heading(case) }}

  <p>Test that JSONPath append mode pushes a value into an existing array in the request body.</p>
  <div id="{{id}}-area" class="testcase-area">
    <div class="testcase-examplecontent" aria-label="{{id}}-example">Example Content</div>
    <div class="testcase-waiting-content" aria-label="{{id}}-waiting">Waiting 500ms to trigger snippet...</div>
    <div class="testcase-expected-view">fetch request body was replaced</div>
  </div>
  <h3>Steps</h3>
  <ul class="testcase-steps">
    <li>Add filter #1.</li>
    <li>Refresh page.</li>
    <li>The script should display a green element and not a red element to the test case above.</li>
  </ul>
  <h3>Filters</h3>
  <ul id="{{id}}-filters" class="testcase-filters">
    <li><pre>{{ site_url|domain }}#$#replace-fetch-request 'jsonpath($.tags)' '"appended-tag"' '' append</pre></li>
  </ul>
</section>

<script>
  "use strict";

  // Register the echo service worker early so it is active when the tests run.
  // The SW intercepts POST /fetch-request-echo and returns the body as-is,
  // allowing the test to verify what the snippet sent.
  const swReady = "serviceWorker" in navigator ?
    navigator.serviceWorker.register("/xhr-echo-sw.js")
      .then(() => navigator.serviceWorker.ready) : Promise.resolve();

  const echoUrl = "/fetch-request-echo";

  // The plain form: fetch takes the body from the init object.
  function postWithInitBody(body) {
    return fetch(echoUrl, {
      method: "POST",
      headers: {"Content-Type": "text/plain"},
      body
    });
  }

  function handleResult(id, passed) {
    const area = document.getElementById(`${id}-area`);
    const element = document.createElement("div");
    element.setAttribute("data-expectedresult", passed ? "pass" : "fail");
    element.setAttribute("aria-label", passed ? `${id}-pass` : `${id}-fail`);
    element.innerHTML = passed ?
      "fetch request body was replaced" :
      "Failed. fetch request body was not replaced";
    area.appendChild(element);
  }

  setTimeout(() => {
    // The first two cases cover the two places fetch takes a body from, which
    // are two different code paths in the snippet: a body in `init` is a plain
    // string and is rewritten synchronously, while a body carried by a Request
    // has to be read asynchronously, which means cloning the Request and
    // rebuilding it around the new body. The rest cover the parameters, and
    // send their bodies the plain way.
    const cases = [
      {
        id: "body-in-init",
        send: () => postWithInitBody('{"trackingId":"abc123","source":"init-body"}'),
        check: body => !body.includes("trackingId") && body.includes("blocked")
      },
      {
        id: "body-on-a-request",
        send: () => fetch(new Request(echoUrl, {
          method: "POST",
          headers: {"Content-Type": "text/plain"},
          body: '{"trackingId":"def456","source":"request-body"}'
        })),
        check: body => !body.includes("trackingId") && body.includes("blocked")
      },
      {
        id: "regex",
        send: () => postWithInitBody('{"adSlot":"ad12345","content":"good"}'),
        check: body => !body.includes("ad12345") && body.includes("removed")
      },
      {
        id: "needle",
        send: () => postWithInitBody('{"userId":"user1","analytics":"tracking-data"}'),
        check: body => !body.includes("userId") && body.includes("blocked")
      },
      {
        id: "jsonpath",
        send: () => postWithInitBody('{"ads":{"enabled":true,"count":5}}'),
        check: body => !body.includes("true") && body.includes("jsonpath-replaced")
      },
      {
        id: "jsonpath-append",
        send: () => postWithInitBody('{"tags":["sports","news"]}'),
        check: body => body.includes("sports") && body.includes("news") &&
          body.includes("appended-tag")
      }
    ];

    swReady.then(() => Promise.all(
      cases.map(({id, send, check}) =>
        send()
        .then(response => response.text())
        .then(body => handleResult(id, check(body)))
        .catch(() => handleResult(id, false))
      )
    )).then(() => {
      removeWaitingContent();
    });
  }, 500);
</script>
