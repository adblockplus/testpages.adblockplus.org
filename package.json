{
  "name": "testpages.adblockplus.org",
  "repository": "https://gitlab.com/eyeo/developer-experience/testpages.adblockplus.org",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "type": "module",
  "dependencies": {
    "express": "^4.22.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@eyeo/get-browser-binary": "^0.26.0",
    "@linthtml/linthtml": "^0.9.5",
    "domutils": "^2.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^7.1.0",
    "eslint-plugin-mocha": "^10.5.0",
    "got": "^14.2.0",
    "htmlparser2": "^7.2.0",
    "jimp": "^0.22.12",
    "mocha": "^10.3.0",
    "nunjucks": "npm:@11ty/nunjucks@^3.3.0",
    "prettier": "^3.3.3",
    "selenium-webdriver": "4.18.1",
    "stylelint": "^16.2.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^36.0.0"
  },
  "scripts": {
    "lint": "npm run linthtml && npm run stylelint && npm run eslint && prettier --check --ignore-unknown .",
    "lint-fix": "npm run eslint -- --fix && npm run stylelint -- --fix && prettier --write --ignore-unknown .",
    "eslint": "eslint eleventy.config.js globals/ filters/ test/extension-tests endpoints/ static/ pages/**/*.njk pages/*.js",
    "linthtml": "linthtml --config test/.linthtmlrc.json static/**/*.html \\*\\*/\\*.njk",
    "stylelint": "stylelint --config test/.stylelintrc.json \"**/*.{css,html}\"",
    "test": "node test/extension-tests/helper-extension/build.js && mocha --delay test/extension-tests/entrypoint.js --",
    "start-endpoints": "node endpoints/start.js",
    "build": "eleventy",
    "serve": "eleventy --serve --port=5001"
  }
}
